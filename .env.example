# ==========================================================================
# Reasoning models — DeepSeek V4 (primary)
# ==========================================================================
# Required. Get one at https://platform.deepseek.com
# V4 supports tool calling, JSON output, a 1M context window and automatic
# context caching (cache hits are ~30x cheaper, which matters a lot for RAG).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model tiering. The agent fans out into many cheap calls (grading, routing,
# rewriting) plus a few expensive ones (planning, synthesis). Routing them to
# different tiers is where most of the cost saving lives.
DEEPSEEK_MODEL_PRO=deepseek-v4-pro      # supervisor, planning, final synthesis
DEEPSEEK_MODEL_FAST=deepseek-v4-flash   # graders, routers, rewriters

# ==========================================================================
# OpenAI — automatic fallback + content moderation
# ==========================================================================
# Optional but recommended. Used when DeepSeek is unset or erroring, and to
# power the moderation guardrail. Needs available quota to be useful.
OPENAI_API_KEY=
OPENAI_MODEL_PRO=gpt-5.6-terra
OPENAI_MODEL_FAST=gpt-5.6-luna
# Point the OpenAI path at a compatible gateway instead of api.openai.com.
# Honoured by generation, the moderation middleware and OpenAI web search, so a
# gateway key is never sent to OpenAI itself. Setting it disables the moderation
# guardrail: that check needs OpenAI's omni-moderation endpoint, which gateways
# do not serve, and a guardrail that can only fail would break every call.
OPENAI_BASE_URL=

# ==========================================================================
# Additional OpenAI-compatible gateways — chained for availability
# ==========================================================================
# Free and trial keys fail in two ways that look identical to the agent: a 429
# burst limit and a 402 exhausted balance. With one provider either ends the
# run. Configure several and modelFallbackMiddleware moves to the next mid-run,
# so an exhausted key costs one retry instead of the request.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRO=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

BLUESMINDS_API_KEY=
BLUESMINDS_BASE_URL=https://api.bluesminds.com/v1
BLUESMINDS_MODEL_PRO=gpt-5.6-terra
BLUESMINDS_MODEL_FAST=gpt-5.6-luna

BAZAARLINK_API_KEY=
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
BAZAARLINK_MODEL_PRO=deepseek-v4-pro
BAZAARLINK_MODEL_FAST=deepseek-v4-flash

# OpenRouter fronts many upstream providers behind one key, so it degrades
# differently from a single-vendor gateway — useful diversity in the chain.
# The site headers are optional attribution; without them traffic is anonymous.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRO=openai/gpt-4o
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Agentic RAG
# Zero-cost alternatives, if you would rather not spend credits here. Verified
# by scripts/model-audit.ts to return real tool calls — 14 of 22 zero-cost
# models did; the rest 429 upstream, need an agentic harness, or serve no
# tool-capable endpoint at all, any of which strands the agent loop:
#   nvidia/nemotron-3-super-120b-a12b:free   fastest, 262k context
#   nvidia/nemotron-3-ultra-550b-a55b:free   largest, 1M context
#   openrouter/free                          lets OpenRouter choose
#   minimax/minimax-m3:free                  1M context, but answered without
#                                            tools on one run — treat as flaky
# Re-check before relying on any of them; free availability moves week to week.

# Google Gemini, through its OpenAI-compatible surface rather than the native
# generateContent API — the native one wants an X-goog-api-key header and a
# `contents` body, which the shared registry cannot speak. Use the flash line:
# gemini-pro-latest returns 429 on a free key. Flash spends budget on thinking
# tokens before emitting text, so a small max_tokens returns empty, not short.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_PRO=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# Mistral. Use the ministral line: mistral-small, magistral-small and
# mistral-vibe-cli-fast all 429 on this tier even after a retry, and the
# labs-leanstral models need an admin to enable Labs access. The ministral,
# codestral and voxtral families answer with working tool calls — 12 of the 18
# models advertising tool support actually delivered them.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_PRO=ministral-14b-latest
MISTRAL_MODEL_FAST=ministral-8b-latest

# Comma-separated, best first. This is an allowlist as well as a ranking: omit
# a provider to drop it from the chain without deleting its key. Leave unset to
# use every provider that has a key, in catalogue order.
#
# Rank by whether a model completes a real agent turn — scripts/agent-competence.ts
# — not by burst tolerance or latency. Those correlate poorly: mistral scores
# top on burst (6/6 at 643ms) and still cannot sustain the loop, so promoting it
# would mean failing over to a broken answer. Also drop, rather than demote, any
# gateway that answers but takes 90s+: as a last hop it consumes the whole
# request budget on its own.
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# ==========================================================================
# Cohere — embeddings + cross-encoder reranking (required)
# ==========================================================================
# embed-v4.0 for vectors, rerank-v4.0-pro for the cross-encoder rerank stage.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro

# ==========================================================================
# Qdrant — persistent vector database
# ==========================================================================
# Without this the app falls back to a non-persistent in-memory store and says
# so at /api/health.
#
# Local:  docker run -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
# Cloud:  https://cloud.qdrant.io (free 1GB tier)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chatbot_documents

# ==========================================================================
# AWS S3 — document storage
# ==========================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Folder inside the bucket that this app owns. Scoping every object under one
# prefix keeps chatbot data from colliding with other applications sharing the
# bucket, and makes a full cleanup a prefix delete rather than a filename hunt.
AWS_S3_PREFIX=chatbot/

# ==========================================================================
# Web search (optional)
# ==========================================================================
# The agent picks the best available provider automatically:
#   Tavily (if set) -> OpenAI gpt-5-search-api (if OPENAI_API_KEY) -> DuckDuckGo
TAVILY_API_KEY=

# ==========================================================================
# Observability (optional)
# ==========================================================================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot-agentic-rag

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
