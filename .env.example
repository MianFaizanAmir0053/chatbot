# ==========================================================================
# Reasoning models — DeepSeek V4 (primary)
# ==========================================================================
# Required. Get one at https://platform.deepseek.com
# V4 supports tool calling, JSON output, a 1M context window and automatic
# context caching (cache hits are ~30x cheaper, which matters a lot for RAG).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model tiering. The agent fans out into many cheap calls (grading, routing,
# rewriting) plus a few expensive ones (planning, synthesis). Routing them to
# different tiers is where most of the cost saving lives.
DEEPSEEK_MODEL_PRO=deepseek-v4-pro      # supervisor, planning, final synthesis
DEEPSEEK_MODEL_FAST=deepseek-v4-flash   # graders, routers, rewriters

# Optional, and only understood by endpoints exposing DashScope's
# `enable_thinking` switch (Alibaba Model Studio, for one). Leave unset for any
# other provider — the parameter is then never sent.
#
# Set to false when the FAST tier is served by a *thinking* model. Reasoning is
# not counted against max_tokens the way a caller expects: a one-word relevance
# grade at max_tokens=16 was measured spending all sixteen tokens on reasoning
# and returning empty content with finish_reason "length", which makes the
# grader fail open and lets every passage through. PRO keeps its reasoning.
# DEEPSEEK_FAST_THINKING=false

# ==========================================================================
# OpenAI — automatic fallback + content moderation
# ==========================================================================
# Optional but recommended. Used when DeepSeek is unset or erroring, and to
# power the moderation guardrail. Needs available quota to be useful.
OPENAI_API_KEY=
OPENAI_MODEL_PRO=gpt-5.6-terra
OPENAI_MODEL_FAST=gpt-5.6-luna
# Point the OpenAI path at a compatible gateway instead of api.openai.com.
# Honoured by generation, the moderation middleware and OpenAI web search, so a
# gateway key is never sent to OpenAI itself. Setting it disables the moderation
# guardrail: that check needs OpenAI's omni-moderation endpoint, which gateways
# do not serve, and a guardrail that can only fail would break every call.
OPENAI_BASE_URL=

# ==========================================================================
# Additional OpenAI-compatible gateways — chained for availability
# ==========================================================================
# Free and trial keys fail in two ways that look identical to the agent: a 429
# burst limit and a 402 exhausted balance. With one provider either ends the
# run. Configure several and modelFallbackMiddleware moves to the next mid-run,
# so an exhausted key costs one retry instead of the request.
# Any provider key field accepts a comma-separated list. Each key becomes its
# own entry against the same endpoint, so a 429 falls to another key at the same
# provider before leaving for a slower one — the cheapest failover there is, and
# the one that matters most on whichever provider leads the chain, since free
# tiers meter per key. Verify a pool with scripts/key-audit.ts: a dead key is
# worse than an absent one, because its failure looks like a rate limit and gets
# retried on every subsequent request instead of being skipped.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRO=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

BLUESMINDS_API_KEY=
BLUESMINDS_BASE_URL=https://api.bluesminds.com/v1
BLUESMINDS_MODEL_PRO=gpt-5.6-terra
BLUESMINDS_MODEL_FAST=gpt-5.6-luna

BAZAARLINK_API_KEY=
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
BAZAARLINK_MODEL_PRO=deepseek-v4-pro
BAZAARLINK_MODEL_FAST=deepseek-v4-flash

# OpenRouter fronts many upstream providers behind one key, so it degrades
# differently from a single-vendor gateway — useful diversity in the chain.
# The site headers are optional attribution; without them traffic is anonymous.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRO=openai/gpt-4o
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Agentic RAG
# Zero-cost alternatives, if you would rather not spend credits here. Verified
# by scripts/model-audit.ts to return real tool calls — 14 of 22 zero-cost
# models did; the rest 429 upstream, need an agentic harness, or serve no
# tool-capable endpoint at all, any of which strands the agent loop:
#   nvidia/nemotron-3-super-120b-a12b:free   fastest, 262k context
#   nvidia/nemotron-3-ultra-550b-a55b:free   largest, 1M context
#   openrouter/free                          lets OpenRouter choose
#   minimax/minimax-m3:free                  1M context, but answered without
#                                            tools on one run — treat as flaky
# Re-check before relying on any of them; free availability moves week to week.

# Hugging Face router. OpenAI-compatible, and it fronts many upstream inference
# providers behind one token. Tool support is per model, not per account — the
# 8B Llama in HF's own docs example rejects a tools array outright with
# INVALID_REQUEST_BODY, which strands the agent loop — so pick from the models
# verified below rather than assuming the router's catalogue is uniform.
# Verified with working tool calls: deepseek-ai/DeepSeek-V3-0324,
# meta-llama/Llama-3.3-70B-Instruct, Qwen/Qwen2.5-72B-Instruct.
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL_PRO=deepseek-ai/DeepSeek-V3-0324
HUGGINGFACE_MODEL_FAST=meta-llama/Llama-3.3-70B-Instruct

# Together AI. OpenAI-compatible, and serves the same gpt-oss family groq does,
# so a funded account substitutes for groq like for like rather than degrading
# quality. Generation needs credits — an unfunded key still authenticates and
# lists models, then returns credit_limit on every completion.
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.ai/v1
TOGETHER_MODEL_PRO=openai/gpt-oss-120b
TOGETHER_MODEL_FAST=openai/gpt-oss-20b

# Google Gemini, through its OpenAI-compatible surface rather than the native
# generateContent API — the native one wants an X-goog-api-key header and a
# `contents` body, which the shared registry cannot speak. Use the flash line:
# gemini-pro-latest returns 429 on a free key. Flash spends budget on thinking
# tokens before emitting text, so a small max_tokens returns empty, not short.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_PRO=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# Mistral. Use the ministral line: mistral-small, magistral-small and
# mistral-vibe-cli-fast all 429 on this tier even after a retry, and the
# labs-leanstral models need an admin to enable Labs access. The ministral,
# codestral and voxtral families answer with working tool calls — 12 of the 18
# models advertising tool support actually delivered them.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_PRO=ministral-14b-latest
MISTRAL_MODEL_FAST=ministral-8b-latest

# Comma-separated, best first. This is an allowlist as well as a ranking: omit
# a provider to drop it from the chain without deleting its key. Leave unset to
# use every provider that has a key, in catalogue order.
#
# Rank by whether a model completes a real agent turn — scripts/agent-competence.ts
# — not by burst tolerance or latency. Those correlate poorly: mistral scores
# top on burst (6/6 at 643ms) and still cannot sustain the loop, so promoting it
# would mean failing over to a broken answer. Also drop, rather than demote, any
# gateway that answers but takes 90s+: as a last hop it consumes the whole
# request budget on its own.
# Reliability outranks latency among providers that already pass the gate: a
# failover that intermittently refuses is worth less than a slow one that always
# answers, so huggingface sits last at 9.6s (credits depleted, burst 5/6) while
# openrouter holds third at 40.8s and 6/6.
# This is an allowlist, not merely a ranking: a provider absent from it is not
# in the chain at all. That is worth stating because the strongest provider can
# be serving the primary slot through DEEPSEEK_BASE_URL and still be missing
# here — in which case it answers the supervisor and nothing else, while the
# failover chain, the auxiliary calls and every research branch fall through to
# whatever is listed. Put the best provider first *and* make sure it is listed.
LLM_PROVIDER_ORDER=alibaba,aionlabs,groq,huggingface,openrouter

# --- Embeddings ---------------------------------------------------------
#
# Which provider embeds documents and queries: cohere (default) or alibaba.
#
# Not a rotation and not a failover — a choice, fixed for the life of a
# collection. Vectors from two embedding models are not comparable even at
# identical width. Measured here: a question embedded by Alibaba scored 0.019
# against the passage that answers it and 0.022 against an unrelated one, while
# the same pair within one provider scored 0.60 and 0.12. Both emit 1536 floats,
# so mixing them raises no error anywhere — every search would simply return
# whatever sat closest to nothing in particular.
#
# Changing this therefore means re-indexing the corpus. The vector store records
# which model wrote a collection and refuses to open it with another, so the
# mistake is caught at startup rather than suffered in the answers.
EMBEDDING_PROVIDER=cohere
# ALIBABA_EMBEDDING_MODEL=text-embedding-v4

# Alibaba Model Studio, as a named chain entry. Defaults to the primary slot's
# key and endpoint, so a deployment already pointing DEEPSEEK_* at Model Studio
# needs neither of these set.
# ALIBABA_API_KEY=
# ALIBABA_BASE_URL=

# Providers allowed to run a delegated research branch (Deep Agents mode).
#
# Deliberately narrower than LLM_PROVIDER_ORDER. The tail of the main chain
# exists to keep a single request alive when everything better is rate-limited,
# and a slow-but-alive gateway is the right answer there. It is the wrong answer
# for a fan-out: branches run concurrently and the supervisor cannot synthesise
# until the slowest returns, so one degraded provider sets the latency of the
# whole turn — and a provider that accepts a tools array but answers without
# using it strands its branch entirely.
#
# Only providers measured as sustaining tool calls under load belong here.
SUBAGENT_PROVIDER_ORDER=groq,gemini,aionlabs

# ==========================================================================
# What extra keys actually buy you, per provider — measured, not assumed
# ==========================================================================
#
# Every provider here accepts a comma-separated list of keys, and each key
# becomes its own entry in the failover chain. What that is worth differs by
# provider, and the difference is invisible until a quota runs out:
#
#   groq      Per-MINUTE limits are per key. The DAILY token allowance (measured
#             at 200k) is per ORGANISATION, and an organisation is an account —
#             so what matters is how many ACCOUNTS the keys come from, not how
#             many keys there are. Eight keys from one account share one 200k
#             day; eight keys from eight accounts are eight separate days.
#             Read the 429 text: it names the organisation that ran out, and
#             only that one is affected. Two distinct org ids appearing in the
#             logs is what established this — a single 429 naming one org was
#             first misread as evidence that every key shared it, when the other
#             keys were in fact still answering.
#
#   aionlabs  Metered per key. Measured directly: with seven keys configured,
#             two returned "429 Daily token limit exceeded" while the other five
#             kept answering — which cannot happen on a shared pool. Extra keys
#             here are real extra daily capacity without needing extra accounts.
#
#   gemini    Per-key rate limits that recover on their own. Seeing most keys
#             busy at once is normal under load and is not a key problem.
#
#   cohere    Trial keys are capped at 1000 calls per MONTH and then fail
#             permanently. A spent key left at the head of the list makes every
#             embedding cycle start with a guaranteed failed round trip, so
#             remove exhausted keys rather than leaving them in.
#
# scripts/key-audit.ts reports each key's real state and distinguishes a busy
# key (429, recovers) from a dead one (401/exhausted trial, never recovers).


# ==========================================================================
# Cohere — embeddings + cross-encoder reranking (required)
# ==========================================================================
# embed-v4.0 for vectors, rerank-v4.0-pro for the cross-encoder rerank stage.
#
# Accepts a comma-separated list, and more than one is worth having: Cohere is
# the only source of both embeddings and reranking, so exhausting its quota does
# not degrade retrieval, it stops it. Embeddings rotate to the next key on a
# rate limit or a dead key; rerank tries every key before backing off, because
# losing it drops the request to fusion order and costs precision.
#
# Do not quote the value. A single quoted key is unwrapped by the env loader,
# but once a second is appended the value is no longer one quoted string, the
# quotes survive, and the first key silently becomes `"abc` and returns 401.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro

# ==========================================================================
# Qdrant — persistent vector database
# ==========================================================================
# Without this the app falls back to a non-persistent in-memory store and says
# so at /api/health.
#
# Local:  docker run -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
# Cloud:  https://cloud.qdrant.io (free 1GB tier)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chatbot_documents

# ==========================================================================
# AWS S3 — document storage
# ==========================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Folder inside the bucket that this app owns. Scoping every object under one
# prefix keeps chatbot data from colliding with other applications sharing the
# bucket, and makes a full cleanup a prefix delete rather than a filename hunt.
AWS_S3_PREFIX=chatbot/

# ==========================================================================
# Web search (optional)
# ==========================================================================
# The agent picks the best available provider automatically:
#   Tavily (if set) -> OpenAI gpt-5-search-api (if OPENAI_API_KEY) -> DuckDuckGo
TAVILY_API_KEY=

# ==========================================================================
# Observability (optional)
# ==========================================================================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot-agentic-rag

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================================================
# Conversation storage
# ==========================================================================
#
# Where chats, their titles and their transcripts live. Without it the app
# writes JSON files under .data/conversations, which is fine locally and fails
# quietly in production: most serverless targets have a read-only disk, so the
# file store degrades to memory and every conversation is lost when the
# instance recycles. A database also makes an append atomic — the file store
# reads, mutates and writes, so two turns arriving together can lose one — and
# lets several instances serve the same conversations.
#
# Any MongoDB connection string works, including a free Atlas cluster. The
# database name comes from the URI path.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/chatbot?appName=Cluster0
